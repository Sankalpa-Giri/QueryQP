# ==============================================================================
# PYQ Recommender System - AWS Hybrid Deployment Environment Template
# ==============================================================================

# 1. Primary Database: AWS RDS PostgreSQL (with pgvector extension)
# Format: postgresql+psycopg2://<username>:<password>@<rds-endpoint>:5432/<database_name>
DATABASE_URL=postgresql+psycopg2://pyquser:YOUR_RDS_PASSWORD@YOUR_RDS_ENDPOINT.rds.amazonaws.com:5432/pyqdb

# 2. Redis Cache & Celery Task Queue (EC2 Docker container or AWS ElastiCache)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# 3. Cloud Object Storage: Amazon S3 (for PDFs and high-res diagram assets)
STORAGE_BACKEND=s3
AWS_S3_BUCKET=your-pyq-papers-bucket-name
AWS_REGION=us-east-1
# Leave keys empty if using EC2 IAM Instance Role (Recommended best practice)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 4. Security & Authentication
JWT_SECRET_KEY=GENERATE_A_64_CHARACTER_RANDOM_STRING_FOR_PRODUCTION
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=CHANGE_THIS_TEMPORARY_BOOTSTRAP_PASSWORD_123

# 5. Document Processing AI (LlamaCloud v2 Parse API)
LLAMA_CLOUD_API_KEY=llx-your-llama-cloud-api-key

# 6. Public Domain / Frontend Connection
NEXT_PUBLIC_API_URL=https://pyq.youruniversity.edu
