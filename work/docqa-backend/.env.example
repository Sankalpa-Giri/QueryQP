# ==============================================================================
# PYQ Recommender System - Backend Environment Template
# Copy this file to .env and fill in your actual credentials
# ==============================================================================

# LLM & Reasoning
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: LangSmith Observability & Tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=docqa-backend

# Cross-Encoder Reranker Model (defaults to ms-marco-MiniLM-L-6-v2)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Document Extraction AI (LlamaCloud v2 Parse API)
# Get your API key from https://cloud.llamaindex.ai/
LLAMA_CLOUD_API_KEY=your_llama_cloud_api_key_here
DOCUMENT_PARSER=auto  # Options: auto, llama_parse, pymupdf

# JWT Secret for Admin Authentication
JWT_SECRET_KEY=change-to-a-secure-random-secret-key-in-production

# Primary Database Connection
# SQLite (Local Dev default): sqlite:///./data/pyq_database.db
# PostgreSQL (Production / Docker): postgresql+psycopg2://pyquser:pyqpassword@localhost:5432/pyqdb
DATABASE_URL=sqlite:///./data/pyq_database.db

# Redis Cache & Celery Queue
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
